{
  "expo": {
    "name": "BryBo",
    "slug": "brybo",
    "scheme": "brybo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0f1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brybo.app",
      "infoPlist": {
        "NSContactsUsageDescription": "BryBo can import contacts from your address book so you can link them to accounts and log entries."
      }
    },
    "android": {
      "package": "com.brybo.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0f1a"
      },
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-contacts",
        {
          "contactsPermission": "BryBo can import contacts from your address book so you can link them to accounts and log entries."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8f7c017b-9586-47fb-bf70-a17e1aeb403e"
      }
    },
    "owner": "knboak"
  }
}
